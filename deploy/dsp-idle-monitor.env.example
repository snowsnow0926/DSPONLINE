DSP_MONITOR_ENDPOINTS=https://dsponline.cn/,https://dsponline.cn/api/health
DSP_MONITOR_DATA_DIRECTORY=/var/lib/dsp-idle-cloud
DSP_NODE_HEALTH_STATUS_FILE=/var/lib/dsp-idle-cloud/node-health-status.json
DSP_MONITOR_TLS_HOST=dsponline.cn
DSP_MONITOR_TLS_PORT=443
DSP_MONITOR_TIMEOUT_MS=8000
DSP_MONITOR_MAX_LATENCY_MS=3000
DSP_MONITOR_MIN_DISK_FREE_RATIO=0.15
# Optional release headroom reservation. Prefer the explicit value when a
# verified snapshot-size estimate is available; otherwise use the formula
# estimated-backup-bytes * backup-count + backup-overhead-bytes.
# DSP_MONITOR_RESERVED_BYTES=0
# DSP_MONITOR_ESTIMATED_BACKUP_BYTES=0
# DSP_MONITOR_BACKUP_COUNT=0
# DSP_MONITOR_BACKUP_OVERHEAD_BYTES=0
DSP_MONITOR_MIN_TLS_DAYS=14
DSP_BACKUP_NODE_ID=hk-production

# Optional alert webhook. The payload contains only node/check names and state.
DSP_ALERT_WEBHOOK_URL=
DSP_ALERT_WEBHOOK_TOKEN=
