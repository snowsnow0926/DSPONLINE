{
  "name": "dsp-idle-network",
  "private": true,
  "version": "1.0.21",
  "releaseChannel": "stable",
  "updateBaseUrl": "",
  "cloudApiBaseUrl": "",
  "description": "戴森球计划风格的 2D 生产网络挂机游戏",
  "homepage": "https://dsponline.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowsnow0926/DSPONLINE.git"
  },
  "bugs": {
    "url": "https://github.com/snowsnow0926/DSPONLINE/issues"
  },
  "author": "DSP Idle Network Contributors",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4318",
    "test": "vitest run",
    "test:e2e": "playwright test --workers=1",
    "test:server": "npm --prefix server test",
    "test:native": "node --test scripts/native-release-tools.test.mjs desktop/release-channels.test.cjs",
    "test:backup": "node --test deploy/backup-tools.test.mjs",
    "test:ops": "node --test deploy/backup-tools.test.mjs deploy/nginx-config.test.mjs deploy/probe-node-health.test.mjs",
    "benchmark:logistics": "cross-env DSP_RUN_LOGISTICS_BENCHMARK=1 vitest run src/game/logisticsBenchmark.test.ts --reporter=verbose",
    "benchmark:refresh": "node scripts/measure-refresh-profiles.mjs",
    "benchmark:v106-belts": "cross-env DSP_RUN_V106_BELT_BENCHMARK=1 vitest run src/game/v106BeltBenchmark.test.ts --reporter=verbose",
    "benchmark:multicore": "node --expose-gc scripts/benchmark-multicore-simulation.mjs",
    "benchmark:canvas": "node scripts/benchmark-canvas-batch.mjs",
    "server:dev": "node server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "release:manifest": "node deploy/create-release-manifest.mjs",
    "release:verify": "node deploy/create-release-manifest.mjs --verify",
    "release:test-switch": "bash deploy/test-switch-release.sh",
    "build:desktop": "node scripts/build-platform.mjs desktop",
    "build:android": "node scripts/build-platform.mjs android",
    "desktop:dev": "cross-env DSP_DESKTOP_DEV_URL=http://127.0.0.1:4318 electron .",
    "desktop:pack": "npm run build:desktop && node desktop/pack.cjs pack",
    "desktop:dist": "npm run build:desktop && node desktop/pack.cjs dist",
    "desktop:release": "node scripts/verify-desktop-signing-env.mjs && npm run desktop:dist && node scripts/create-native-update-manifests.mjs --desktop-source release",
    "android:sync": "npm run build:android && cap sync android && node scripts/sync-native-versions.mjs",
    "android:debug": "cross-env DSP_ANDROID_DEBUG=1 npm run android:sync && android\\gradlew.bat -p android assembleDebug",
    "android:release:unsigned": "npm run android:sync && android\\gradlew.bat -p android bundleRelease assembleRelease",
    "android:release": "node scripts/verify-android-signing-env.mjs && npm run android:release:unsigned",
    "native:assets": "node scripts/generate-native-assets.mjs",
    "native:manifests": "node scripts/create-native-update-manifests.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@xyflow/react": "^12.9.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.dspidle.network",
    "productName": "DSP极简网络",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "build/icon.png",
      "LICENSE",
      "NOTICE",
      "COMMERCIAL_USE.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "dsp-idle-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.DSP_DESKTOP_PUBLISH_URL}"
      }
    ]
  }
}
